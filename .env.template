# Environment
NODE_ENV=
MULTI_TENANT=
LOG_LEVEL=

# Release identity (ISS-2482). Set by the Docker build from the git release
# tag and commit; leave empty locally (reported as `unknown`).
APP_VERSION=
GIT_SHA=

# Elasticsearch
ELASTIC_NODE=
ELASTIC_API_KEY=

# MongoDB
MONGODB_URI=

# Redis
REDIS_URL=
CMS_REDIS_URL=

# Mapbox
MAPBOX_API_KEY=

# Stapi
STRAPI_URL=
STRAPI_TOKEN=

# Keycloak
KEYCLOAK_URL=

# Rate Limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=60
INTERNAL_API_KEY=

# Metrics
# Set to true/1/yes/on to serve GET /metrics for Prometheus scraping (default: disabled).
# Enable only in Kubernetes; keep disabled on DigitalOcean App Platform.
PROMETHEUS_METRICS_ENDPOINT_ENABLED=
# Optional bearer token; when set, GET /metrics requires "Authorization: Bearer <token>"
PROMETHEUS_METRICS_TOKEN=

# Hybrid search
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
RUNPOD_API_KEY=
# Own embedding server (TEI), no key. When set, each query embedding asks it and
# EMBEDDING_BASE_URL at the same time and uses the first good answer. It must
# serve the same model as EMBEDDING_MODEL. Empty = EMBEDDING_BASE_URL only.
EMBEDDING_LOCAL_BASE_URL=
# Query embedding cache. Off only when exactly `false`; default on.
EMBEDDING_CACHE_ENABLED=
# Lifetime of a cached query embedding in ms (positive integer; default 86400000 = 24 h).
EMBEDDING_CACHE_TTL_MS=
# /v2/search classify cache (59 min TTL). Off only when exactly `false`; default on.
CLASSIFY_CACHE_ENABLED=
# Need boost from stored SUNE need weights (ISS-2745). On by default (ADR 0039
# Decision 79); set `false` to turn it off. Only v2 sends need scores.
# Needs the sune_need_weights rank_features mapping on the index first.
NEED_BOOST_ENABLED=

ML_BROKER_BASE_URL=
ML_BROKER_API_KEY=
# Send emergency_only for AI-off tenants; set `true` only when ml-broker supports it
ML_BROKER_EMERGENCY_ONLY_SUPPORTED=

# One switch for all /v2/search routes: on only for the exact value `true`, anything else is 404 (ISS-2499)
V2_SEARCH_ENABLED=
# Question rule v1 for /v2/search; on only for `true` (any case, no spaces), anything else runs the old engine
V2_QUESTION_RULE_V1=
# Timeout of the /v2/search classify call in ms (integer; default 1000)
V2_CLASSIFY_TIMEOUT_MS=

# Opencage
OPENCAGE_API_KEY=

# Umami (analytics)
UMAMI_API_URL=
UMAMI_API_KEY=

# Analytics cache
# Set to "false" to disable the in-process L1 (LRU) cache and rely on Redis (L2) only.
ANALYTICS_L1_CACHE_ENABLED=
ANALYTICS_RESPONSE_LRU_MAX=
ANALYTICS_CONFIG_LRU_MAX=
ANALYTICS_SESSION_CACHE_TTL_MS=

# Arcjet (optional — omit/leave empty to disable Arcjet bot/abuse protection)
ARCJET_KEY=

# Permissions side-channel
PERMISSIONS_SIDECHANNEL_BASE_URL=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_USERNAME=
OTEL_EXPORTER_OTLP_PASSWORD=
OTEL_TRACES_SAMPLER_ARG=

