# Environment
NODE_ENV=
MULTI_TENANT=
LOG_LEVEL=

# Elasticsearch
ELASTIC_NODE=
ELASTIC_API_KEY=

# MongoDB
MONGODB_URI=

# Redis
REDIS_URL=
CMS_REDIS_URL=

# Mapbox
MAPBOX_API_KEY=

# Stapi
STRAPI_URL=
STRAPI_TOKEN=

# Keycloak
KEYCLOAK_URL=

# Rate Limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=60
INTERNAL_API_KEY=

# Metrics
PROMETHEUS_PUSHGATEWAY_URL=
PROMETHEUS_PUSH_INTERVAL_MS=
PROMETHEUS_PUSHGATEWAY_USERNAME=
PROMETHEUS_PUSHGATEWAY_PASSWORD=
# Set to false/0/no/off to disable periodic Pushgateway pushes (default: enabled)
PROMETHEUS_PUSH_METRICS_ENABLED=
# Set to true/1/yes/on to serve GET /metrics for Prometheus scraping (default: disabled).
# Enable only in Kubernetes; keep disabled on DigitalOcean App Platform.
PROMETHEUS_METRICS_ENDPOINT_ENABLED=
# Optional bearer token; when set, GET /metrics requires "Authorization: Bearer <token>"
PROMETHEUS_METRICS_TOKEN=

# Hybrid search
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
RUNPOD_API_KEY=

ML_BROKER_BASE_URL=
ML_BROKER_API_KEY=

# Opencage
OPENCAGE_API_KEY=

# Umami (analytics)
UMAMI_API_URL=
UMAMI_USERNAME=
UMAMI_PASSWORD=

# Analytics cache
# Set to "false" to disable the in-process L1 (LRU) cache and rely on Redis (L2) only.
ANALYTICS_L1_CACHE_ENABLED=
ANALYTICS_RESPONSE_LRU_MAX=
ANALYTICS_CONFIG_LRU_MAX=
ANALYTICS_SESSION_CACHE_TTL_MS=

# Comma-separated tenant IDs that use a trailing-slash convention for their
# search resource paths (e.g. "/search/" instead of "/search").
TRAILING_SLASH_TENANTS=

# Arcjet
ARCJET_KEY=

# Permissions side-channel
PERMISSIONS_SIDECHANNEL_BASE_URL=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=

